# posiq. · plantilla de configuración. Copia a `.env` (`cp .env.example .env`) y rellena.
# `.env` NUNCA se sube al repo (está en .gitignore). Ninguna clave va en el código.
#
# Valores de esta plantilla = SEGUROS: sin claves, LLM de fixture, kit sin coste y tope de 5 €.
# Con ellos no hay ninguna llamada de pago. Para medir de verdad sigue docs/medicion-real.md.
#
# REGLA DE ORO: el kit (Clínica Alborada) es un caso SINTÉTICO y va separado del modo real.
# Clínica Alborada no existe: no se mide en modo real.
#
# Las claves (*_API_KEY, LANGFUSE_*_KEY) solo se leen de este .env, nunca del entorno del SO.

# --- Proveedor del LLM de los nodos (intake, market, prompts, plan, redacción) -----------------
# fixture: respuestas fijas, sin red ni coste (demo y tests). deepseek: LLM de pago.
LLM_PROVIDER=fixture

# DeepSeek (LLM de los nodos y fallback del juez). Vacía = sin LLM de pago.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Vacío = el modelo por defecto del adaptador.
DEEPSEEK_MODEL=

# --- Juez de menciones -------------------------------------------------------------------------
# TypeSafe / Jev. Vacía = sin Jev (con DEEPSEEK_API_KEY, fallback LLM; sin ninguna, reglas).
TYPESAFE_API_KEY=
# Versión fijada de Jev (reproducible). `jev-latest` es un alias que cambia con cada release:
# usa el MISMO juez en toda una serie de mediciones o los deltas no son comparables.
JEV_MODEL=jev-1.13
# auto: Jev o fallback LLM según las claves · reglas: solo aparición y posición, sin llamadas
JUDGE_PROVIDER=auto
JUDGE_CONFIDENCE_ACCEPT=0.80
JUDGE_CONFIDENCE_FALLBACK=0.55
JUDGE_CONCURRENCY=8

# --- Motores de IA a medir (solo modo real) ----------------------------------------------------
# Solo se lanzan los motores con clave. Vacía = motor desactivado (se avisa en el log).
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Claude es el motor más caro (~10x ChatGPT por token): vacía salvo que quepa en el tope.
ANTHROPIC_API_KEY=

# --- Presupuesto ---------------------------------------------------------------------------------
# Tope de gasto por estudio en EUR. Se comprueba antes de cada llamada; con llamadas en vuelo
# (hasta 8 a la vez) puede excederse en unas pocas. Al superarse, el estudio para en «error» con
# lo gastado trazado. Estima antes: `GET /estimate?modo=real&n_prompts=..&n_motores=..`.
BUDGET_EUR_MAX=5
# Modo real: tope de prompts del banco generado (0 = sin tope). 52 prompts x 4 motores x 3
# repeticiones estiman ~10,6 € (por encima del tope); con 20 prompts y 3 motores, ~3 €.
REAL_MAX_PROMPTS=20

# --- Modo kit (caso sintético) -----------------------------------------------------------------
KIT_DIR=data/kit/02_Datos/caso_oftalmologia
# Modo kit: siempre sin coste (LLM y juez de fixture, sin PlanGuard) aunque haya claves.
# true = opt-in para usar el LLM y el juez de pago sobre las respuestas del kit (ADR 0018).
KIT_IA_REAL=false

# --- Auditoría técnica de la web (ADR 0019) ----------------------------------------------------
# off | fixture | real. `off` por defecto: no se descarga nada de la web de la marca.
# En modo kit, `real` se degrada a fixture (CASO SINTÉTICO, sin red). Tope por recurso (s, máx. 10).
WEB_AUDIT=off
WEB_AUDIT_TIMEOUT_S=10

# --- Persistencia y caché ----------------------------------------------------------------------
DATABASE_URL=sqlite:///./posiq.db
# Caché en disco de llamadas pagadas: repetir una llamada idéntica no vuelve a pagar.
CACHE_ENABLED=true
CACHE_PATH=.cache/posiq_cache.sqlite

# --- Observabilidad (opcional) -----------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Precios (verificar en la documentación oficial vigente antes de medir) --------------------
# LLM y juez en USD por millón de tokens.
DEEPSEEK_PRICE_IN_USD_PER_M=0.28
DEEPSEEK_PRICE_OUT_USD_PER_M=0.42
JEV_PRICE_IN_USD_PER_M=0.04
JEV_PRICE_OUT_USD_PER_M=0
USD_EUR=0.86

# Motores reales (ADR 0006): concurrencia y reintentos
ENGINE_CONCURRENCY=4
ENGINE_MAX_RETRIES=4
ENGINE_BACKOFF_BASE_S=1.0

# Modelos de los motores reales
OPENAI_ENGINE_MODEL=gpt-5-mini
GEMINI_ENGINE_MODEL=gemini-2.5-flash
PERPLEXITY_ENGINE_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai
ANTHROPIC_ENGINE_MODEL=claude-opus-5-5
# Búsquedas web y tokens de salida por llamada de Claude: bajarlos abarata cada llamada.
ANTHROPIC_ENGINE_MAX_SEARCHES=5
ANTHROPIC_ENGINE_MAX_TOKENS=16000
# Fallback de servidor a otro modelo si Claude rechaza: opt-in, rompe la comparabilidad
ANTHROPIC_ENGINE_FALLBACK=false

# Precios de los motores: provisional, contrastar con la página de precios.
# _IN/_OUT en USD por millón de tokens; _SEARCH en USD por búsqueda (Gemini y Perplexity: por petición)
PRICING_CHATGPT_IN=0.25
PRICING_CHATGPT_OUT=2.00
PRICING_CHATGPT_SEARCH=0.01
PRICING_GEMINI_IN=0.30
PRICING_GEMINI_OUT=2.50
PRICING_GEMINI_SEARCH=0.035
PRICING_PERPLEXITY_IN=1.00
PRICING_PERPLEXITY_OUT=1.00
PRICING_PERPLEXITY_SEARCH=0.005
PRICING_CLAUDE_IN=4.00
PRICING_CLAUDE_OUT=20.00
PRICING_CLAUDE_SEARCH=0.01

# --- Cuentas (ADR 0015) --------------------------------------------------------------------------
# Duración de la sesión en horas (7 días)
AUTH_TOKEN_TTL_H=168
# Devolver el código de verificación en la respuesta (codigo_dev). Sin fijar: SOLO con
# LLM_PROVIDER=fixture. No lo actives con el LLM real. No hay proveedor de correo: el código
# siempre se escribe en el log del servidor.
# AUTH_DEV_CODES=false
# Correo que ve los estudios anteriores a las cuentas (sin propietario). Vacío: nadie. Solo vale en
# modo demo (códigos de desarrollo activos, es decir, LLM_PROVIDER=fixture).
AUTH_DEMO_USER=
# scrypt de contraseñas y códigos (n potencia de 2). Los hashes guardan sus parámetros.
AUTH_SCRYPT_N=16384
AUTH_SCRYPT_R=8
AUTH_SCRYPT_P=1
# Intentos por minuto en /auth/*, por IP y ruta y, en login/verify/reenviar, también por correo
# (en memoria, un solo proceso). Además, 3 reenvíos de código por correo y hora.
AUTH_RATE_LIMIT_POR_MIN=10
# Tamaño máximo del brief en bytes (413 si se pasa)
BRIEF_MAX_BYTES=200000
